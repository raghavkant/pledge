---
// The free practice test moved to the home page on 2026-10-01 (docs/seo-sprint.md), so the two pages don't
// compete for the same searches. GitHub Pages can't send a 301, so this is an instant meta refresh, which
// Google treats as a permanent redirect, plus a canonical link to the home page. It is left out of the
// sitemap and of the checks that open pages in a browser (scripts/lib.mjs, builtPages). The question pool
// (questions.json) stays at this address.
import { url, absoluteUrl } from '../../../lib/url';

const to = url('') + '#practice-test';
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The free practice test has moved · Pledge</title>
    <link rel="canonical" href={absoluteUrl('')} />
  </head>
  <body>
    <p>The free practice test is now on the <a href={to}>Pledge home page</a>.</p>
  </body>
</html>
