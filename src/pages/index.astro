---
// Home page, Direction A "Night to morning" (docs/design.md §5). Since the SEO sprint (docs/seo-sprint.md) the
// hero carries the free practice test itself, and the app's story follows below. Every number comes from the
// export (src/data/au/app-stats.json) or from src/data/au/facts.ts (docs/facts.md).
// Motion (§7): CSS for the hero and the sky; src/scripts/home.ts for tilt, the story and the count-up.
import Base from '../layouts/Base.astro';
import Phone from '../components/home/Phone.astro';
import Quiz from '../components/Quiz.astro';
import { url, absoluteUrl } from '../lib/url';
import brand from '../lib/brand-paths.json';
import stats from '../data/au/app-stats.json';
import { CHECKED, SOURCES, TEST, YEAR } from '../data/au/facts';
import { GUIDES } from '../data/au/guides';

const homeGuides = [GUIDES.format, GUIDES.values, GUIDES.testDay, GUIDES.ocb];

// A quiet night sky: the same stars on every build (seeded), drawn in one small SVG.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 70 }, () => ({
  x: +(rand() * 1600).toFixed(1),
  y: +(rand() * 900).toFixed(1),
  r: +(0.5 + rand() * 1.1).toFixed(2),
  o: +(0.2 + rand() * 0.55).toFixed(2),
}));

const counts = [
  { n: stats.questions, label: 'practice questions' },
  { n: stats.lessons, label: 'lessons in simple English' },
  { n: stats.flashcards, label: 'flashcards' },
  { n: stats.valuesQuestions, label: 'values questions' },
];

const plans = [
  { feature: 'Lessons', free: `Part 1: ${stats.free.lessons} lessons`, premium: `All ${stats.lessons} lessons` },
  { feature: 'Practice questions', free: `Part 1: ${stats.free.part1Questions} questions`, premium: `All ${stats.questions} questions` },
  { feature: 'Values drill', free: `${stats.free.valuesQuestions} values questions`, premium: `All ${stats.valuesQuestions} values questions` },
  { feature: 'Mock tests', free: 'One full mock test', premium: 'Unlimited mock tests' },
  { feature: 'Flashcards', free: `Part 1: ${stats.free.flashcards} flashcards`, premium: `All ${stats.flashcards} flashcards` },
  { feature: 'Review your mistakes', free: 'Mistakes on free questions', premium: 'Every mistake' },
  { feature: 'Progress and study plan', free: 'Included', premium: 'Included' },
];

const steps = [
  {
    screen: 'lesson' as const,
    title: 'Learn the booklet in simple English',
    text: `${stats.lessons} lessons follow the four parts of Our Common Bond, with the key facts pulled out. Listen reads any lesson aloud.`,
  },
  {
    screen: 'question' as const,
    title: 'Practise with the answer and the page',
    text: 'After every question you see the right answer, why, and the page of the booklet to read again.',
  },
  {
    screen: 'mock-result' as const,
    title: 'Sit mock tests in the real format',
    text: `${stats.mockTest.questions} questions in ${stats.mockTest.minutes} minutes, marked with both pass rules, so you know where you stand before test day.`,
  },
];
---
<Base
  title={`Free Australian Citizenship Practice Test ${YEAR} | Pledge`}
  description="Take a free Australian citizenship practice test: 20 questions marked with the real pass rules, with the answer and booklet page after each. No sign-up."
  path=""
  schema={[
    { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Pledge', url: absoluteUrl(''), inLanguage: 'en-AU', description: 'An independent study app and free guides for the Australian citizenship test.' },
    {
      '@context': 'https://schema.org', '@type': 'Quiz', name: 'Free Australian citizenship practice test',
      description: `${TEST.questions} practice questions (${TEST.questions - TEST.valuesQuestions} from Part 1 of Our Common Bond and ${TEST.valuesQuestions} on Australian values), marked with both pass rules. Pledge's own questions, not questions from the real test.`,
      url: absoluteUrl('') + '#practice-test', inLanguage: 'en-AU', isAccessibleForFree: true, learningResourceType: 'Practice test',
      about: { '@type': 'Thing', name: 'Australian citizenship test' },
      author: { '@type': 'Person', name: 'Raghav Kant', url: absoluteUrl('about/') },
    },
  ]}
>
  <main id="main" class="home">
    <!-- Hero: the night sky, the gold map, and the free practice test itself -->
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-dawn" aria-hidden="true"></div>
      <svg class="hero-stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
      </svg>
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1 id="home-title">Free Australian citizenship practice test</h1>
          <p class="hero-lead">{TEST.questions} questions, marked with the real pass rules. After each one, see the answer and the booklet page to read. No sign-up.</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <svg class="hero-map" viewBox="95 106 810 813" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
              <defs>
                <linearGradient id="map-gold" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#F7D38E" />
                  <stop offset="1" stop-color="#E9AE4E" />
                </linearGradient>
                <path id="au-map-path" d={brand.map} />
              </defs>
              <use class="map-fill" href="#au-map-path" fill="url(#map-gold)" />
              <path class="map-line" d={brand.map} pathLength="1" />
              <path class="map-sparkle" d={brand.sparkle} />
            </svg>
        </div>
        <div class="hero-test" id="practice-test">
          <Quiz mode="test" first="p1-027" />
          <p class="hero-note">Pledge’s own questions, written from the booklet: {TEST.questions - TEST.valuesQuestions} from Part 1 and {TEST.valuesQuestions} on Australian values. They are not questions from the real test, which covers all four parts of <em>Our Common Bond</em>. Nothing is saved: reloading starts a new test.</p>
        </div>
        <p class="hero-fine">Pass rules checked against <a href={SOURCES.test}>Home Affairs</a> on <time datetime={CHECKED.iso}>{CHECKED.label}</time>. Independent study app. Not affiliated with the Australian Government.</p>
      </div>
    </section>

    <!-- The rule that decides a pass -->
    <section class="rule" aria-labelledby="rule-title">
      <div class="container">
        <h2 id="rule-title" class="home-h2">The rule that decides a pass</h2>
        <div class="rule-grid">
          <div class="rule-item">
            <p class="rule-num">{TEST.passMark}<span> of {TEST.questions}</span></p>
            <p class="rule-text">At least {TEST.passMark} of the {TEST.questions} questions correct.</p>
          </div>
          <p class="rule-and">and</p>
          <div class="rule-item rule-values">
            <p class="rule-num">{TEST.valuesQuestions}<span> of {TEST.valuesQuestions}</span></p>
            <p class="rule-text">Every Australian values question correct. Miss one and you don’t pass, even with {TEST.questions - 1} of {TEST.questions}.</p>
          </div>
        </div>
        <p class="rule-foot">Pledge marks every mock test with both rules. Checked against <a href={SOURCES.test}>Home Affairs</a> on <time datetime={CHECKED.iso}>{CHECKED.label}</time>.</p>
      </div>
    </section>

    <!-- About the practice test: what it is and isn't -->
    <section class="about-test" aria-labelledby="about-test-title">
      <div class="container about-grid">
        <div class="about-head">
          <h2 id="about-test-title" class="home-h2">About this practice test</h2>
          <p>Free, with no sign-up and no limit. Take a new test as often as you like: each one draws new questions in a new order.</p>
          <p class="about-links"><a class="btn btn-primary" href="#practice-test">Start the practice test</a></p>
        </div>
        <div class="about-qa">
          <h3>How does it work?</h3>
          <ul>
            <li><strong>{TEST.questions - TEST.valuesQuestions} questions from Part 1</strong> of <em>Our Common Bond</em> (Australia and its people) and <strong>{TEST.valuesQuestions} Australian values questions</strong>, in a random order.</li>
            <li>After each question: the right answer, why, and the booklet page to read again.</li>
            <li>Your result is marked with both pass rules, then you can review every answer.</li>
            <li>You can add a {TEST.minutes}-minute timer, like the real test, and pause it.</li>
          </ul>
          <h3>Is this the real citizenship test?</h3>
          <p>No. These are Pledge’s own practice questions, written from the booklet. About its own practice test, <a href={SOURCES.prepare}>Home Affairs</a> says: “It is a sample test only. The questions will be different on the day of the test.”</p>
          <h3>What does the real test cover?</h3>
          <p>{TEST.questions} multiple choice questions in {TEST.minutes} minutes, in English, from all four parts of <em>Our Common Bond</em>: Australia and its people; democratic beliefs, rights and liberties; government and the law; and Australian values. See <a href={url(GUIDES.format.path)}>the test format and pass mark</a>.</p>
          <h3>Where can I practise more for free?</h3>
          <ul>
            <li><a href={url(GUIDES.questions.path)}>50 practice questions with answers</a>, also as a printable PDF.</li>
            <li>The <a href={url(GUIDES.values.path) + '#drill'}>values drill</a>: all {stats.free.valuesQuestions} of our free values questions.</li>
            <li>The <a href={SOURCES.practice}>Home Affairs practice test</a> and the free booklet, <a href={SOURCES.booklet}><em>Our Common Bond</em> (PDF)</a>.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- The app: from first lesson to test day. On desktop, one sticky phone changes screen as the steps scroll by -->
    <section class="story" aria-labelledby="story-title">
      <div class="container">
        <h2 id="story-title" class="home-h2">Pledge, the app: from first lesson to test day</h2>
        <p class="story-lead">This practice test comes from Pledge, an independent iPhone app for the whole booklet. <span class="pill pill-quiet">Coming soon to iPhone</span></p>
        <div class="story-grid">
        <div class="story-stage" aria-hidden="true">
          <Phone screen={steps.map((s) => s.screen)} class="stage-phone" />
        </div>
        <ol class="story-steps">
          {steps.map((s) => (
            <li class="story-step" data-step={s.screen}>
              <Phone screen={s.screen} class="story-phone" />
              <div class="story-text">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <!-- Real numbers, from the export -->
    <section class="numbers" aria-labelledby="numbers-title">
      <div class="container numbers-grid">
        <div class="numbers-head">
          <h2 id="numbers-title" class="home-h2">All of the booklet, in one app</h2>
          <p>Written from the four parts of <em>Our Common Bond</em>. Every answer shows the page it comes from. Premium unlocks all of it; Part 1 and {stats.free.valuesQuestions} values questions are free.</p>
        </div>
        <ul class="count-lines">
          {counts.map((c) => (
            <li>
              <span class="visually-hidden">{c.n} {c.label}</span>
              <span class="count-n" data-count={c.n} style={`--d: ${String(c.n).length}`} aria-hidden="true">{c.n}</span>
              <span class="count-label" aria-hidden="true">{c.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Private by design: three glass cards over the map -->
    <section class="private" aria-labelledby="private-title">
      <svg class="private-map" viewBox="95 180 810 740" aria-hidden="true"><use href="#au-map-path" fill="url(#map-gold)" /></svg>
      <div class="container">
        <div class="private-head">
          <h2 id="private-title" class="home-h2">Private by design</h2>
          <p>Everything works offline except buying Premium. <a href={url('privacy/')}>Read the Privacy Policy</a></p>
        </div>
        <ul class="glass-cards">
          <li class="glass">
            <h3>No account</h3>
            <p>No sign-up, no email and no password. Open the app and start studying.</p>
          </li>
          <li class="glass">
            <h3>Your progress stays on your phone</h3>
            <p>Your answers, scores and mistakes are saved on your phone only. They are never sent anywhere.</p>
          </li>
          <li class="glass">
            <h3>No ads, no tracking</h3>
            <p>The app has no ads, analytics or tracking, and neither does this website.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- Free vs Premium: honest, no prices here (see the App Store) -->
    <section class="plans" aria-labelledby="plans-title">
      <div class="container plans-grid">
        <div class="plans-head">
          <h2 id="plans-title" class="home-h2">Free to start</h2>
          <p>Part 1, {stats.free.valuesQuestions} values questions and a full mock test are free, for as long as you like. Premium is an in-app subscription that unlocks everything else. You’ll see the price in the App Store before you buy.</p>
        </div>
        <div class="plans-table-wrap">
          <table class="plans-table">
            <caption class="visually-hidden">What is free in Pledge and what Premium unlocks</caption>
            <thead>
              <tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col">Free</th><th scope="col" class="is-premium">Premium</th></tr>
            </thead>
            <tbody>
              {plans.map((p) => (
                <tr><th scope="row">{p.feature}</th><td>{p.free}</td><td class="is-premium">{p.premium}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Guides -->
    <section class="guides" aria-labelledby="guides-title">
      <div class="container">
        <h2 id="guides-title" class="home-h2">Understand the test</h2>
        <p class="guides-lead">Plain-English guides, each quoting Home Affairs with the date we checked.</p>
        <ul class="guide-links">
          {homeGuides.map((g) => (
            <li><a href={url(g.path)}><span class="guide-link-title">{g.title}</span><span class="guide-link-blurb">{g.blurb}</span></a></li>
          ))}
        </ul>
        <p class="guides-all"><a href={url('australia/')}>All guides and free Home Affairs resources</a></p>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/home';
</script>

<style is:global>
  /* ---------- Home: shared ---------- */
  .home-h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem); line-height: 1.04; letter-spacing: -0.025em; text-wrap: balance; }
  .btn-gold { background: var(--gold); color: var(--night-0); }
  .home section { position: relative; }

  /* ---------- Hero: the night sky, with the practice test in a card over the gold map ---------- */
  .hero {
    isolation: isolate; overflow: clip; color: var(--on-night);
    background: linear-gradient(180deg, var(--night-0) 0%, var(--night-mid) 58%, #1D2C98 88%, #2438B0 100%);
    padding: clamp(28px, 5vw, 64px) 0 clamp(96px, 12vw, 180px);
  }
  .hero::after {
    content: ''; position: absolute; inset: auto 0 -1px 0; z-index: -1; height: clamp(90px, 12vw, 190px);
    background:
      radial-gradient(55% 100% at 50% 100%, var(--horizon-glow), rgba(242, 192, 107, 0) 74%),
      linear-gradient(180deg, rgba(36, 56, 176, 0) 0%, var(--bg) 100%);
  }
  .hero-stars { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; fill: var(--ivory); }
  .hero-dawn {
    position: absolute; inset: 0; z-index: -1; opacity: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(58, 84, 214, 0) 0%, rgba(92, 104, 214, 0.45) 55%, rgba(242, 192, 107, 0.55) 100%);
  }
  .hero-grid { display: grid; gap: clamp(22px, 4vw, 40px); grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'test' 'fine'; }
  .hero-copy { grid-area: copy; position: relative; }
  .hero h1 {
    margin: 0; max-width: 14ch;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.35rem, 1.2rem + 4.6vw, 5.4rem); line-height: 1.0; letter-spacing: -0.032em;
    text-wrap: balance;
  }
  .hero-lead { max-width: 34rem; margin: clamp(14px, 1.6vw, 24px) 0 0; color: var(--on-night-soft); font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.3rem); line-height: 1.6; }
  .hero-fine { grid-area: fine; margin: 0; max-width: 46rem; color: var(--on-night-soft); font-size: 0.9375rem; }
  .hero-fine a { color: var(--on-night); }
  .hero :focus-visible { outline-color: var(--gold); }
  .hero .quiz :focus-visible { outline-color: var(--focus); }

  /* The test card: the night's one bright object. */
  .hero-test { grid-area: test; position: relative; scroll-margin-top: 16px; }
  .hero .quiz { position: relative; z-index: 1; color: var(--ink-soft); }
  .hero .quiz-panel { padding: clamp(20px, 3.2vw, 40px); border-color: rgba(246, 244, 239, 0.5); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 40px 90px -30px rgba(3, 6, 30, 0.75), 0 12px 30px rgba(3, 6, 30, 0.3); }
  .hero .quiz-results h2 { scroll-margin-top: 28px; }
  .hero-note { max-width: 40rem; margin: 16px 0 0; color: var(--on-night-soft); font-size: 0.9375rem; line-height: 1.55; }
  @media (prefers-color-scheme: dark) {
    .hero .quiz-panel { border-color: rgba(242, 192, 107, 0.28); box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(242, 192, 107, 0.08); }
  }
  @media (max-width: 559px) { .quiz-timer-add .t-long { display: none; } }

  /* The gold map, drawn on desktop in the space under the headline (phones keep the map in the header mark). */
  .hero-visual { grid-area: map; display: none; position: relative; min-height: 0; }
  .hero-visual::before {
    content: ''; position: absolute; inset: -10% -6% -10% -14%; z-index: -1;
    background: radial-gradient(50% 50% at 42% 52%, rgba(242, 192, 107, 0.24), rgba(242, 192, 107, 0.07) 55%, rgba(242, 192, 107, 0) 100%);
  }
  .hero-map { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .map-line { fill: none; stroke: var(--gold-0); stroke-width: 3; stroke-linejoin: round; opacity: 0; }
  .map-sparkle { fill: var(--ivory); transform-box: fill-box; transform-origin: center; }
  @media (min-width: 1100px) {
    .hero { padding-block: clamp(40px, 5vh, 80px) clamp(150px, 16vh, 210px); }
    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); grid-template-rows: auto minmax(200px, 1fr) auto;
      grid-template-areas: 'copy test' 'map test' 'fine fine'; column-gap: clamp(48px, 5vw, 96px); row-gap: clamp(24px, 3vh, 40px);
    }
    .hero-copy { padding-top: clamp(4px, 2vh, 28px); }
    .hero h1 { max-width: 11ch; font-size: clamp(3.6rem, 1rem + 4vw, 5.6rem); }
    .hero-visual { display: block; max-height: 420px; margin-bottom: 24px; }
  }

  /* ---------- Phone frame (neutral, drawn by us) ---------- */
  .phone { --pw: 240px; width: var(--pw); margin: 0; aspect-ratio: 9 / 19.5; }
  .phone-body {
    height: 100%; padding: 3.2%; border-radius: 15% / 7%;
    background: linear-gradient(145deg, #2A2F45, #0B0E1C 60%);
    box-shadow: 0 0 0 1px rgba(246, 244, 239, 0.14) inset, 0 30px 60px -12px rgba(5, 9, 40, 0.55), 0 8px 18px rgba(5, 9, 40, 0.28);
  }
  .phone-screen { position: relative; height: 100%; border-radius: 12.5% / 5.8%; background: linear-gradient(170deg, #2743D6 0%, #17237A 55%, #0E1650 100%); }
  .phone-screen::before { content: ''; position: absolute; top: 2.6%; left: 50%; width: 30%; height: 3.4%; margin-left: -15%; border-radius: 99px; background: #05070F; }
  .phone-screen img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .screen-slot { display: flex; flex-direction: column; justify-content: center; height: 100%; padding: 0 12%; color: var(--ivory); text-align: left; }
  .screen-sparkle { width: calc(var(--pw) * 0.13); margin-bottom: calc(var(--pw) * 0.075); fill: var(--gold); }
  .screen-name { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: calc(var(--pw) * 0.122); line-height: 1.05; letter-spacing: -0.02em; }
  .screen-caption { margin: calc(var(--pw) * 0.047) 0 0; color: var(--on-night-soft); font-size: calc(var(--pw) * 0.06); font-weight: 600; line-height: 1.4; }
  .screen-note { position: absolute; left: 12%; right: 12%; bottom: 7%; margin: 0; color: rgba(246, 244, 239, 0.66); font-size: calc(var(--pw) * 0.049); font-weight: 600; line-height: 1.35; }

  /* ---------- The rule ---------- */
  .rule { padding: clamp(24px, 4vw, 48px) 0 clamp(88px, 11vw, 168px); }
  .rule-grid { display: grid; gap: 8px; margin-top: clamp(28px, 4vw, 56px); grid-template-columns: minmax(0, 1fr); align-items: start; }
  .rule-num { margin: 0; color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: clamp(6.5rem, 3rem + 14vw, 15rem); line-height: 0.86; letter-spacing: -0.055em; font-variant-numeric: lining-nums; }
  .rule-num span { font-size: 0.3em; letter-spacing: -0.02em; color: var(--muted); }
  .rule-values .rule-num { color: var(--ochre); }
  .rule-text { max-width: 24rem; margin: 18px 0 0; color: var(--ink-soft); font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; }
  .rule-and { margin: 18px 0 10px; color: var(--muted); font-size: 1.125rem; font-weight: 700; }
  .rule-foot { max-width: 44rem; margin: clamp(32px, 4vw, 56px) 0 0; padding-top: 22px; border-top: 1px solid var(--hairline); color: var(--muted); font-size: 1rem; }
  @media (min-width: 900px) {
    .rule-grid { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: clamp(24px, 4vw, 72px); }
    .rule-and { margin: 0; padding-top: clamp(4.2rem, 2rem + 9vw, 9.6rem); }
  }
  @media (prefers-color-scheme: dark) { .rule-values .rule-num { color: #F0B566; } }

  /* ---------- About this practice test ---------- */
  .about-test { padding: 0 0 clamp(88px, 11vw, 168px); }
  .about-grid { display: grid; gap: clamp(28px, 4vw, 48px); grid-template-columns: minmax(0, 1fr); }
  .about-head p { max-width: 30rem; margin: 18px 0 0; }
  .about-links { margin-top: 28px !important; }
  .about-qa { max-width: var(--measure); }
  .about-qa h3 { margin: 0 0 0.4em; color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem); line-height: 1.2; letter-spacing: -0.012em; }
  .about-qa * + h3 { margin-top: 1.7em; }
  .about-qa p, .about-qa ul { margin: 0; }
  .about-qa ul { padding-left: 1.2em; }
  .about-qa li { margin: 0.4em 0; padding-left: 0.2em; }
  .about-qa li::marker { color: var(--accent); }
  .about-qa strong { color: var(--ink); }
  @media (min-width: 1000px) {
    .about-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(48px, 6vw, 110px); align-items: start; }
    .about-head { position: sticky; top: 40px; }
  }

  /* ---------- Story ---------- */
  .story-lead { max-width: 36rem; margin: 18px 0 clamp(8px, 4vw, 64px); }
