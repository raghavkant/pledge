---
// On every page: the disclaimer and "General information, not migration advice." (docs/rules.md, rules 7–8),
// the CC BY credit for Our Common Bond, legal links and the support email.
import { url } from '../lib/url';

const email = 'pledge.citizenship.help@gmail.com';
const year = 2026;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={url()}>
          <img src={url('mark.svg')} alt="" width="30" height="30" />
          <span>Pledge</span>
        </a>
        <p>Pledge is an independent study app. It is not affiliated with or endorsed by the Australian Government.</p>
        <p>General information, not migration advice.</p>
      </div>
      <nav aria-labelledby="footer-guides">
        <h2 id="footer-guides">Guides</h2>
        <ul class="footer-links">
          <li><a href={url('australia/')}>The test in plain English</a></li>
          <li><a href={url('australia/test-format/')}>Test format</a></li>
          <li><a href={url('australia/values-questions/')}>Values questions</a></li>
          <li><a href={url('australia/practice-test/')}>Free practice test</a></li>
          <li><a href={url('australia/faq/')}>Questions and answers</a></li>
          <li><a href={url('about/')}>About Pledge</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-help">
        <h2 id="footer-help">Help and legal</h2>
        <ul class="footer-links">
          <li><a href={url('support/')}>Support</a></li>
          <li><a href={url('privacy/')}>Privacy Policy</a></li>
          <li><a href={url('terms/')}>Terms of Use</a></li>
        </ul>
      </nav>
      <div>
        <h2>Contact</h2>
        <ul class="footer-links">
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <p>Contains material from <em>Australian Citizenship: Our Common Bond</em>, © Commonwealth of Australia, licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
      <p>© {year} Raghav Kant</p>
    </div>
  </div>
</footer>
