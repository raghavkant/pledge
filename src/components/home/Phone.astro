---
// A neutral phone frame drawn in CSS (no Apple device image), holding named screen slots.
// Pass one screen, or several to stack them as layers (the scroll story swaps between them).
// Space is reserved with aspect-ratio, so nothing shifts. See src/assets/screens/.
import { screens, type ScreenSlot } from '../../assets/screens';
import brand from '../../lib/brand-paths.json';

interface Props { screen: ScreenSlot | ScreenSlot[]; class?: string; eager?: boolean }
const { screen, class: className, eager = false } = Astro.props;
const list = Array.isArray(screen) ? screen : [screen];
const layered = list.length > 1;
---
<figure class:list={['phone', className]} data-screen={list.join(' ')}>
  <div class="phone-body">
    <div class="phone-screen">
      {list.map((name, i) => {
        const slot = screens[name];
        const layer = layered ? { 'data-layer': name, class: i === 0 ? 'is-active' : undefined } : {};
        return slot.image ? (
          <img {...layer} src={slot.image.src} width={slot.image.width} height={slot.image.height} alt={`The ${slot.name.toLowerCase()} screen in Pledge.`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
        ) : (
          <div class:list={['screen-slot', layer.class]} data-layer={layer['data-layer']}>
            <svg class="screen-sparkle" viewBox="714 116 184 184" aria-hidden="true"><path d={brand.sparkle} /></svg>
            <p class="screen-name">{slot.name}</p>
            <p class="screen-caption">{slot.caption}</p>
            <p class="screen-note">App screenshot coming at launch</p>
          </div>
        );
      })}
    </div>
  </div>
</figure>
