---
// A guide page (docs/design.md §4): the answer first in the night hero, then the reading column with a
// quiet side column on desktop (On this page, the Home Affairs check date, sources). Every fact in a guide
// comes from docs/facts.md (docs/rules.md, rule 5).
import Base from './Base.astro';
import { url, absoluteUrl } from '../lib/url';
import { CHECKED, SOURCES } from '../data/au/facts';
import { PRACTICE, type GuideLink } from '../data/au/guides';

type SourceKey = keyof typeof SOURCES;
const SOURCE_NAMES: Record<SourceKey, string> = {
  test: 'Home Affairs: Learn about the citizenship test',
  prepare: 'Home Affairs: Prepare for the citizenship test',
  practice: 'Home Affairs: Citizenship practice test',
  booklet: 'Home Affairs: Australian Citizenship: Our Common Bond (PDF)',
  ocb: 'Home Affairs: Our Common Bond',
  conferral: 'Home Affairs: Citizenship by conferral for permanent residents',
  fees: 'Home Affairs: Form 1298i, citizenship fees (PDF)',
  locator: 'Home Affairs: Citizenship test locator',
  ptimes: 'Home Affairs: Citizenship processing times',
  immiaccount: 'Home Affairs: ImmiAccount',
};

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  /** The answer, in one or two plain sentences. Shown first. */
  answer: string;
  sources: SourceKey[];
  related?: GuideLink[];
  /** "booklet" for guides that summarise Our Common Bond rather than Home Affairs web pages. */
  kind?: 'rules' | 'booklet';
  /** Questions and plain-text answers for FAQPage structured data (pages whose visible text is questions and answers). */
  faq?: { q: string; a: string }[];
  /** More structured data for this page (for example a Quiz), added to the Article and breadcrumbs. */
  schema?: object[];
  /** The date the page was first published (ISO), for structured data. */
  published?: string;
}
const { title, description, path, h1, answer, sources, related = [], kind = 'rules', faq, schema: extra = [], published = '2026-09-26' } = Astro.props;
const isAbout = path.startsWith('about/');

// Structured data: the guide as an Article, its place in the site as a breadcrumb trail, and (FAQ page) FAQPage.
const author = { '@type': 'Person', name: 'Raghav Kant', url: absoluteUrl('about/') + '#author' };
const crumbs = isAbout
  ? [{ name: 'Pledge', path: '' }, { name: 'About Pledge', path: 'about/' }]
  : [{ name: 'Pledge', path: '' }, { name: 'Australian citizenship test', path: 'australia/' }];
if (path.startsWith('australia/our-common-bond/part-')) crumbs.push({ name: 'Our Common Bond', path: 'australia/our-common-bond/' });
if (path !== 'australia/' && path !== 'about/') crumbs.push({ name: h1, path });
const schema: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: h1, description, inLanguage: 'en-AU',
    datePublished: published, dateModified: CHECKED.iso, author, publisher: author,
    mainEntityOfPage: absoluteUrl(path), image: absoluteUrl(`og/${path.replace(/\/$/, '').replace(/[/.]/g, '-')}.jpg`),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: absoluteUrl(c.path) })),
  },
];
schema.push(...extra);
if (faq) schema.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

// "On this page" from the guide's h2 headings (each needs an id).
const body = await Astro.slots.render('default');
const toc = [...body.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((m) => ({ id: m[1], text: m[2].replace(/<span class="pg"[^>]*>[\s\S]*?<\/span>/g, '').replace(/<[^>]+>/g, '').trim() }));
---
<Base title={title} description={description} path={path} schema={schema}>
  <main id="main" class="guide">
    <header class="night page-hero guide-hero">
      <div class="container">
        <h1>{h1}</h1>
        <p class="guide-answer">{answer}</p>
        {kind === 'booklet' ? (
          <p class="lead-in">By <a href={url('about/') + '#author'}>Raghav Kant</a>. Summarised from <em>Australian Citizenship: Our Common Bond</em> (Home Affairs, CC BY 4.0), downloaded <time datetime={CHECKED.iso}>{CHECKED.label}</time>. General information, not migration advice.</p>
        ) : (
          <p class="lead-in">By <a href={url('about/') + '#author'}>Raghav Kant</a>. Checked against Home Affairs on <time datetime={CHECKED.iso}>{CHECKED.label}</time>. General information, not migration advice.</p>
        )}
      </div>
    </header>
    <div class="container reading">
      <aside class="toc guide-side" aria-label="About this guide">
        {toc.length > 2 && (
          <nav aria-labelledby="toc-title">
            <p id="toc-title">On this page</p>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        )}
        <p class="side-note">{kind === 'booklet'
          ? 'Page numbers are the printed pages of Our Common Bond.'
          : 'Every fact about the test is quoted from Home Affairs.'}
          <span class="side-checked">Last checked: <time datetime={CHECKED.iso}>{CHECKED.label}</time></span>
          {path !== 'about/how-we-check-facts/' && <a href={url('about/how-we-check-facts/')}>How we check facts</a>}</p>
      </aside>
      <article class="prose">
        <Fragment set:html={body} />
        <slot name="tool" />
        {!isAbout && (
          <aside class="practice-cta" aria-labelledby="practice-cta-title">
            <p id="practice-cta-title" class="practice-cta-title">Test yourself for free</p>
            <p>{PRACTICE.blurb} No sign-up.</p>
            <a class="btn btn-primary" href={url(PRACTICE.path)}>Take the free practice test</a>
          </aside>
        )}
        <h2 id="sources">Sources</h2>
        <ul class="sources">
          {sources.map((k) => <li><a href={SOURCES[k]}>{SOURCE_NAMES[k]}</a></li>)}
        </ul>
        <p class="advice">For advice about your own situation, contact <a href="https://immi.homeaffairs.gov.au/help-support/contact-us">Home Affairs</a> or a <a href="https://www.mara.gov.au/">registered migration agent</a>.</p>
        {related.length > 0 && (
          <nav class="related" aria-labelledby="related-title">
            <h2 id="related-title">Keep reading</h2>
            <ul class="cards">
              {related.map((g) => (
                <li><a class="card" href={url(g.path)}><span class="card-title">{g.title}</span><p>{g.blurb}</p></a></li>
              ))}
            </ul>
          </nav>
        )}
      </article>
    </div>
  </main>
</Base>

<style is:global>
  .guide-hero h1 { max-width: 20ch; }
  .guide-answer { max-width: 38rem; margin: 1.3rem 0 0; color: var(--on-night); font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem); line-height: 1.5; font-weight: 600; text-wrap: pretty; }
  .guide .lead-in { font-size: 0.9375rem; }
  .guide-side .side-note { margin: 1.6rem 0 0; padding-top: 1rem; border-top: 1px solid var(--hairline); color: var(--muted); font-size: 0.875rem; line-height: 1.5; }
  .guide-side .side-note > * { display: block; margin-top: 0.5rem; }
  .guide-side .side-checked { color: var(--ink); font-weight: 700; }
  .guide-side .side-note a { color: var(--accent); font-weight: 600; }
  .guide .lead-in a { color: var(--on-night); }
  .prose .practice-cta { margin: 2.6em 0 0; padding: 1.4rem 1.6rem 1.6rem; border-radius: var(--radius-m); color: var(--on-night-soft); background: linear-gradient(160deg, var(--night-0), var(--night-mid)); }
  .prose .practice-cta p { margin: 0 0 0.9rem; }
  .prose .practice-cta .practice-cta-title { margin-bottom: 0.3rem; color: var(--on-night); font-family: var(--font-display); font-size: 1.4rem; line-height: 1.2; }
  .prose .practice-cta .btn { background: var(--gold); color: var(--night-0); text-decoration: none; }
  .prose .practice-cta :focus-visible { outline-color: var(--gold); }
  @media print { .prose .practice-cta { display: none; } }
  .prose blockquote { margin: 1.4em 0; padding: 0.2em 0 0.2em 1.2em; border-left: 3px solid var(--gold-1); color: var(--ink); }
  .prose blockquote p { margin: 0.4em 0; }
  .prose blockquote cite { display: block; margin-top: 0.4em; color: var(--muted); font-size: 0.9375rem; font-style: normal; }
  .prose .sources { padding-left: 1.2em; }
  .prose .advice { margin-top: 1.6em; padding: 1rem 1.2rem; border-radius: var(--radius-s); background: var(--sunk); font-size: 1rem; }
  .prose .related { margin-top: 3em; }
  .prose .related .cards { grid-template-columns: minmax(0, 1fr); margin-top: 1rem; }
  @media (min-width: 760px) { .prose .related .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .prose .related .card { text-decoration: none; }
  .prose .related li { margin: 0; padding: 0; }
  .prose h2 .pg { display: block; margin-top: 0.3em; color: var(--muted); font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; letter-spacing: 0; }
  .prose .pg { color: var(--muted); }
  .prose table.plain { width: 100%; margin: 1.2em 0; border-collapse: collapse; font-size: 0.975rem; line-height: 1.45; }
  .prose table.plain th, .prose table.plain td { padding: 10px 10px 10px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--hairline); }
  .prose table.plain thead th { color: var(--ink); border-bottom: 2px solid var(--ink); }
  .prose table.plain tbody th { color: var(--ink); font-weight: 700; }
  .prose dl.facts { display: grid; gap: 0; margin: 1.4em 0; }
  .prose dl.facts > div { display: grid; grid-template-columns: minmax(5.5rem, 30%) 1fr; gap: 16px; padding: 14px 0; border-top: 1px solid var(--hairline); }
  .prose dl.facts > div:last-child { border-bottom: 1px solid var(--hairline); }
  .prose dl.facts dt { color: var(--ink); font-weight: 700; }
  .prose dl.facts dd { margin: 0; }
</style>
